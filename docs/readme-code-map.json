    {
      "id": "mirror_items",
      "readmeTexts": [
        "**World Reflection Mirror** creates the default temporary mirror copy of the current area.",
        "**Heaven Mirror** creates a temporary mirror where you enter in Creative mode for testing.",
        "**First Dream Mirror** creates original terrain again from the current world seed"
      ],
      "code": [
        {
          "label": "item registry",
          "adapter": "file_contains_all",
          "file": "src/main/java/com/crabmods/instantworldmirror/registry/ModItems.java",
          "texts": [
            "DIMENSION_MIRROR",
            "HEAVEN_MIRROR",
            "FIRST_DREAM_MIRROR",
            "mirrorItem(MirrorKind kind)"
          ]
        },
        {
          "label": "mirror kind behavior",
          "adapter": "file_contains_all",
          "file": "src/main/java/com/crabmods/instantworldmirror/world/MirrorKind.java",
          "texts": [
            "DIMENSION(",
            "HEAVEN(",
            "FIRST_DREAM(",
            "isSandbox()",
            "usesPristineTerrain()"
          ]
        }
      ]
    },
    {
      "id": "portal_flow",
      "readmeTexts": [
        "Right-click a solid block with any mirror to create an entry portal.",
        "Inside a normal mirror world, hold right-click with the World Reflection Mirror or First Dream Mirror to return to the entrance.",
        "Heaven Mirror worlds can only leave through the original entrance."
      ],
      "code": [
        {
          "label": "block right-click portal flow",
          "adapter": "method_contains_in_order",
          "file": "src/main/java/com/crabmods/instantworldmirror/item/DimensionMirrorItem.java",
          "method": "useOn",
          "texts": [
            "state.isSolidRender",
            "ModDimensions.isAnyMirrorWorld",
            "createReturnPortal",
            "createEntryPortal"
          ]
        },
        {
          "label": "hold right-click return flow",
          "adapter": "method_contains_in_order",
